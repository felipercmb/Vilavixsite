# Chaves VITE são públicas no navegador. Use apenas a chave publicável/anon.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Apenas servidor: nunca prefixar segredos com VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ZERNIO_API_KEY=
ZERNIO_ACCOUNT_ID=
ZERNIO_AD_ACCOUNT_ID=

# Apenas servidor: entrada direta dos formulários de lead da Meta.
# O token de verificação deve ser aleatório e exclusivo desta integração.
META_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=

# Edge Function only: dedicated cron secret; use the same value in Supabase Vault.
CAMPAIGN_SYNC_CRON_KEY=
